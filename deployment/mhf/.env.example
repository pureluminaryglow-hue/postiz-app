# Copy this file to deployment/mhf/.env on your server; NEVER commit .env.
# Replace URL with an owned domain/subdomain that already resolves to your server.
POSTIZ_PUBLIC_URL=https://postiz.example.org

# Generate independent, high-entropy secrets. Avoid punctuation in database passwords
# unless you URL-encode it in DATABASE_URL.
POSTIZ_JWT_SECRET=REPLACE_WITH_UNIQUE_LONG_RANDOM_SECRET
POSTIZ_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
POSTIZ_DB_PASSWORD=REPLACE_WITH_UNIQUE_ALPHANUMERIC_DB_PASSWORD
TEMPORAL_DB_PASSWORD=REPLACE_WITH_UNIQUE_ALPHANUMERIC_DB_PASSWORD
DISABLE_REGISTRATION=false

# OAuth credentials: leave blank until platform developer apps are approved.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
